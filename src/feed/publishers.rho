//
// @file publishers.rho
// @brief The publishers: handing the files of a refresh to each of a feed's publishers, and taking a snapshot back when a feed goes.
//
// @module feed
// @project robohub-feed
// @author Aurel Miron
// @date 2026-11-20
//
// SPDX-License-Identifier: MIT
//

module feed

// A publisher receives the files of one refresh — the feed's snapshot and
// widget.js, with a small example.html — and puts each in place atomically
// (FEED-0006). The `directory` publisher writes each file beside its target
// under a hidden temporary name and renames it over the target, so a web server
// or a sync tool serving the folder never reads half a file. A publisher of a
// kind that does not exist yet, or a folder the rules refuse, is a failure with
// its reason, and the next refresh tries again.
//
// The `http` publisher (FEED-0008) sends the same files with a PUT each to its
// base URL followed by the file's name, through curl, with the bearer token from
// the publisher's owner-only token file. The token reaches curl in a
// configuration file written owner-only for that one request and removed when
// curl is done, never on a command line; no error it records holds it.

// feed_publish hands one feed's snapshot to each of its publishers and answers
// their failures, "; "-separated, or "" when every one succeeded.
// @req FEED-0006
fn feed_publish(text: string, feed: string, snapshot: string) string {
    let names: string = fd_feed_publishers(feed)
    var errors: string = ""
    var i: u32 = 0
    while i <= fd_comma_count(names) {
        let name: string = str_trim(str_field(names, ",", i))
        i = i + 1
        if name == "" {
            continue
        }
        let failed: string = feed_publish_to(fd_publisher_line(text, name), name, fd_feed_id(feed), snapshot)
        if failed != "" {
            if errors != "" {
                errors = errors + "; "
            }
            errors = errors + name + ": " + failed
        }
    }
    if str_trim(names) == "" {
        return "the feed has no publisher"
    }
    return errors
}

// feed_publish_to is one publisher's part: "" when its files are in place, or
// why they are not.
// @req FEED-0005, FEED-0006, FEED-0008
fn feed_publish_to(publisher: string, name: string, id: string, snapshot: string) string {
    if publisher == "" {
        return "no such publisher"
    }
    let kind: string = fd_publisher_kind(publisher)
    if !fp_kind_exists(kind) {
        return "publishers of kind " + kind + " do not exist yet"
    }
    if str_eq(kind, "http") {
        return feed_publish_http(fd_publisher_target(publisher), name, id, snapshot)
    }
    let folder: string = fd_publisher_target(publisher)
    if !fp_dir_ok(folder, feed_home(), feed_dir()) {
        return "the folder " + folder + " is not one a publisher may write to"
    }
    var failed: string = feed_put(fp_widget_path(folder), rho_asset("feed", "static/widget.js"))
    if failed == "" {
        failed = feed_put(fp_example_path(folder), rho_asset("feed", "static/example.html"))
    }
    if failed == "" {
        failed = feed_put(fp_snapshot_path(folder, id), snapshot)
    }
    return failed
}

// feed_publish_http sends each file of a refresh to an http publisher's site,
// stopping at the first that is not answered 2xx: "" when every one was, or the
// failure with its status (FEED-0008).
// @req FEED-0008
fn feed_publish_http(base: string, name: string, id: string, snapshot: string) string {
    if !fp_url_ok(base) {
        return "the address " + base + " is not one a publisher may put to"
    }
    let token: string = feed_token(name)
    if !fp_token_ok(token) {
        return "no token is set"
    }
    let names: string = fp_http_names(id)
    var k: u32 = 0
    while true {
        let file: string = str_field(names, "\n", k)
        k = k + 1
        if file == "" {
            break
        }
        var content: string = snapshot
        if !str_starts_with(file, "feeds/") {
            content = rho_asset("feed", "static/" + file)
        }
        let failed: string = feed_http_put(fp_http_url(base, file), token, file, content)
        if failed != "" {
            return failed
        }
    }
    return ""
}

// feed_http_put sends one file with a PUT. The body and curl's configuration —
// the address and the token — are files only this user can read, named afresh
// in the workspace's tmp/ and removed once curl is done.
// @req FEED-0008
fn feed_http_put(url: string, token: string, file: string, content: string) string {
    if content == "" {
        return file + ": nothing to send"
    }
    let unique: string = rho_random_hex(8)
    if unique == "" {
        return "no random source"
    }
    let dir: string = feed_dir() + "/tmp"
    if !feed_mkdir(dir) {
        return "could not make " + dir
    }
    let body: string = dir + "/put-" + unique + ".body"
    let config: string = dir + "/put-" + unique + ".curl"
    let output: string = dir + "/put-" + unique + ".out"
    var failed: string = ""
    if !rho_write_secret(body, content) || !rho_write_secret(config, fp_curl_config(url, token, fp_content_type(file))) {
        failed = file + ": could not prepare the request"
    } else {
        let exit: u32 = rho_exec_args("curl", fp_curl_args(body, config), output)
        let answer: string = rho_read_text(output)
        failed = fp_http_failure(file, exit, fp_curl_status(answer), fp_curl_error(answer))
    }
    ignore_u32(rho_exec_args("rm", "-f\n--\n" + config + "\n" + body + "\n" + output + "\n", "/dev/null"))
    return failed
}

// feed_put puts one file in place: written beside it, then renamed over it.
// @req FEED-0006
fn feed_put(target: string, content: string) string {
    if content == "" {
        return "nothing to write to " + target
    }
    let slash: i32 = fp_last_slash(target)
    if slash > 0 && !feed_mkdir(str_slice(target, 0, u32(slash))) {
        return "could not make the folder of " + target
    }
    let unique: string = rho_random_hex(6)
    if unique == "" {
        return "no random source"
    }
    let temporary: string = fp_temp_path(target, unique)
    if !rho_write_text(temporary, content) {
        ignore_u32(rho_exec_args("rm", "-f\n" + temporary + "\n", "/dev/null"))
        return "could not write " + target
    }
    if rho_exec_args("mv", "-f\n" + temporary + "\n" + target + "\n", "/dev/null") != 0 {
        ignore_u32(rho_exec_args("rm", "-f\n" + temporary + "\n", "/dev/null"))
        return "could not rename into " + target
    }
    return ""
}

// feed_unpublish takes a feed's snapshot back from the directory publishers
// named (a comma-separated list): when the feed is deleted, or a publisher is
// taken off it (FEED-0007).
// @req FEED-0007
fn feed_unpublish(text: string, id: string, names: string) void {
    if !fd_id_ok(id) {
        return
    }
    var i: u32 = 0
    while i <= fd_comma_count(names) {
        let name: string = str_trim(str_field(names, ",", i))
        i = i + 1
        let publisher: string = fd_publisher_line(text, name)
        if publisher == "" || !str_eq(fd_publisher_kind(publisher), "directory") {
            continue
        }
        let folder: string = fd_publisher_target(publisher)
        if fp_dir_ok(folder, feed_home(), feed_dir()) {
            ignore_u32(rho_exec_args("rm", "-f\n" + fp_snapshot_path(folder, id) + "\n", "/dev/null"))
        }
    }
}
