//
// @file publish.rho
// @brief Publishers as rules: which kinds exist, which folders a directory publisher may write to, which addresses an http publisher may put to, and the names of what they write.
//
// @module feed.domain.publish
// @project robohub-feed
// @author Aurel Miron
// @date 2026-11-20
//
// SPDX-License-Identifier: MIT
//

module feed.domain.publish

// A publisher receives the files of one refresh — each enabled feed's snapshot
// and widget.js — and puts each in place atomically (FEED-0006). The kinds are
// pluggable; `directory`, a folder on this machine, and `http`, a web site that
// takes each file with an HTTPS PUT and the publisher's bearer token (FEED-0008,
// robohub ADR-0026, 3), exist, and a publisher of any other kind is refused
// until it does (robohub ADR-0019 leaves where the files are hosted to later
// decisions, each about the credential its kind needs).
//
// A directory publisher writes where the person says, so where that may be is a
// rule: an absolute, plain path (no `.` or `..` part, no empty part, nothing
// that is not printable), not the root or a system folder, not the home folder
// itself, and no hidden folder on the way — which keeps ~/.rho (the keeper's
// keys, the registry), ~/.ssh and ~/.config out of reach — except inside the
// application's own workspace, where its default publisher writes.

// fp_kind_exists is whether a publisher kind is one the application has.
// @req FEED-0006, FEED-0008
fn fp_kind_exists(kind: string) bool {
    return str_eq(kind, "directory") || str_eq(kind, "http")
}

// fp_kind_planned is whether a kind is one robohub ADR-0019 names for later
// (git, ssh, s3): offered on the page as not available yet, and refused.
fn fp_kind_planned(kind: string) bool {
    return str_eq(kind, "git") || str_eq(kind, "ssh") || str_eq(kind, "s3")
}

// fp_trim_slash is a path without the slashes it ends with ("/" stays "/").
fn fp_trim_slash(path: string) string {
    var p: string = path
    while strlen(p) > 1 && str_at(p, strlen(p) - 1) == 47 {
        p = str_slice(p, 0, strlen(p) - 1)
    }
    return p
}

// fp_under is whether a path is a folder or inside it.
fn fp_under(path: string, folder: string) bool {
    if folder == "" {
        return false
    }
    return str_eq(path, folder) || str_starts_with(path, folder + "/")
}

// The folders of the system a publisher never writes into.
const FP_SYSTEM: string = "/bin,/boot,/dev,/etc,/lib,/lib32,/lib64,/proc,/root,/run,/sbin,/sys,/usr,/var/lib,/var/log"

// fp_dir_ok is whether a directory publisher may write into a folder, given the
// home folder and the application's workspace (FEED-0006).
// @req FEED-0006
fn fp_dir_ok(path: string, home: string, workspace: string) bool {
    let raw: string = path
    let n: u32 = strlen(raw)
    if n < 2 || n > 512 || str_at(raw, 0) != 47 {
        return false
    }
    var i: u32 = 0
    while i < n {
        let c: u8 = str_at(raw, i)
        if c < 32 || c == 127 || c == 124 || c == 92 {
            return false
        }
        i = i + 1
    }
    let p: string = fp_trim_slash(raw)
    if str_eq(p, "/") || str_contains(p, "//") {
        return false
    }
    // Every part after the first slash: none empty, none `.` or `..`, and none
    // hidden outside the workspace.
    let ws: string = fp_trim_slash(workspace)
    let inside: bool = strlen(ws) > 1 && fp_under(p, ws) && !str_eq(p, ws)
    var k: u32 = 1
    while true {
        let part: string = str_field(p, "/", k)
        if part == "" {
            break
        }
        if str_eq(part, ".") || str_eq(part, "..") {
            return false
        }
        if str_at(part, 0) == 46 && !inside {
            return false
        }
        k = k + 1
    }
    if inside {
        return true
    }
    var s: u32 = 0
    while true {
        let system: string = str_field(FP_SYSTEM, ",", s)
        if system == "" {
            break
        }
        if fp_under(p, system) {
            return false
        }
        s = s + 1
    }
    let h: string = fp_trim_slash(home)
    if strlen(h) > 1 && str_eq(p, h) {
        return false
    }
    return true
}

// fp_snapshot_path is where a feed's snapshot is in a publisher's folder:
// `feeds/<id>.json`. The id has been checked to be hexadecimal, so it cannot
// name anything else.
// @req FEED-0003, FEED-0006
fn fp_snapshot_path(folder: string, id: string) string {
    return fp_trim_slash(folder) + "/feeds/" + id + ".json"
}

fn fp_widget_path(folder: string) string {
    return fp_trim_slash(folder) + "/widget.js"
}

fn fp_example_path(folder: string) string {
    return fp_trim_slash(folder) + "/example.html"
}

// fp_temp_path is the file a publisher writes before renaming it into place:
// beside the target, in the same folder (so the rename is one step), hidden and
// unique.
// @req FEED-0006
fn fp_temp_path(target: string, unique: string) string {
    let slash: i32 = fp_last_slash(target)
    if slash < 0 {
        return "." + target + "." + unique + ".tmp"
    }
    let dir: string = str_slice(target, 0, u32(slash))
    let name: string = str_slice(target, u32(slash) + 1, strlen(target) - u32(slash) - 1)
    return dir + "/." + name + "." + unique + ".tmp"
}

fn fp_last_slash(path: string) i32 {
    var i: u32 = strlen(path)
    while i > 0 {
        i = i - 1
        if str_at(path, i) == 47 {
            return i32(i)
        }
    }
    return -1
}

/* -------------------------------------------------------------------------- */
/*  The http publisher (FEED-0008)                                            */
/* -------------------------------------------------------------------------- */

// An http publisher sends each file of a refresh with a PUT to its base URL
// followed by the file's name — the same names, and the same set, a directory
// publisher writes — carrying `Authorization: Bearer <token>`. The token is kept
// in an owner-only file beside the feed file, one per publisher, and is never in
// the feed file, a page or the log. The base URL is HTTPS; plain http only to
// the loopback, for tests. A publish is done only when every PUT is answered
// 2xx within FP_HTTP_TIMEOUT_S; anything else is the failure, with its status.

// How long one PUT may take, connecting included, and how long the connection.
const FP_HTTP_TIMEOUT_S: u32 = 15
const FP_HTTP_CONNECT_S: u32 = 10

// The longest base URL and token kept.
const FP_URL_MAX: u32 = 512
const FP_TOKEN_MAX: u32 = 4096

// fp_url_ok is whether an http publisher may put to a base URL: `https://` and a
// host, or `http://` to 127.0.0.1, localhost or [::1] alone, each with an
// optional port and path; printable, with no user or password, query, fragment,
// quote, backslash or field separator in it.
// @req FEED-0008
fn fp_url_ok(url: string) bool {
    let n: u32 = strlen(url)
    if n > FP_URL_MAX {
        return false
    }
    var i: u32 = 0
    while i < n {
        let c: u8 = str_at(url, i)
        // control, space, " # ? @ \ | and DEL
        if c <= 32 || c == 127 || c == 34 || c == 35 || c == 63 || c == 64 || c == 92 || c == 124 {
            return false
        }
        i = i + 1
    }
    var rest: string = ""
    var secure: bool = false
    if str_starts_with(url, "https://") {
        rest = str_slice(url, 8, n - 8)
        secure = true
    } else if str_starts_with(url, "http://") {
        rest = str_slice(url, 7, n - 7)
    } else {
        return false
    }
    let slash: i32 = str_index_of(rest, "/")
    var authority: string = rest
    if slash >= 0 {
        authority = str_slice(rest, 0, u32(slash))
    }
    let host: string = fp_url_host(authority)
    if host == "" || !fp_url_port_ok(authority, host) {
        return false
    }
    if str_contains(rest, "/../") || str_contains(rest, "/./") || str_contains(rest, "//") {
        return false
    }
    if secure {
        return true
    }
    return fp_url_loopback(host)
}

// fp_url_host is the host of an authority (`host`, `host:port`, `[v6]` or
// `[v6]:port`), "" when there is none.
// @req FEED-0008
fn fp_url_host(authority: string) string {
    if str_starts_with(authority, "[") {
        let close: i32 = str_index_of(authority, "]")
        if close < 2 {
            return ""
        }
        return str_slice(authority, 0, u32(close) + 1)
    }
    let colon: i32 = str_index_of(authority, ":")
    if colon >= 0 {
        return str_slice(authority, 0, u32(colon))
    }
    return authority
}

// fp_url_port_ok is whether what follows the host in an authority is nothing,
// or a colon and a port of 1 to 5 digits.
// @req FEED-0008
fn fp_url_port_ok(authority: string, host: string) bool {
    let after: string = str_slice(authority, strlen(host), strlen(authority) - strlen(host))
    if after == "" {
        return true
    }
    if !str_starts_with(after, ":") || strlen(after) < 2 || strlen(after) > 6 {
        return false
    }
    var i: u32 = 1
    while i < strlen(after) {
        let c: u8 = str_at(after, i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

// fp_url_loopback is whether a host is the loopback, where plain http is
// allowed for tests.
// @req FEED-0008
fn fp_url_loopback(host: string) bool {
    return str_eq(host, "127.0.0.1") || str_eq(host, "localhost") || str_eq(host, "[::1]")
}

// fp_http_url is where one file goes: the base URL, a slash, and the file's
// name as a directory publisher names it.
// @req FEED-0008
fn fp_http_url(base: string, name: string) string {
    return fp_trim_slash(base) + "/" + name
}

// fp_http_names are the names of the files of one refresh, in the order they
// are sent, one per line: the same set a directory publisher writes, the
// snapshot last so a page never reads a snapshot before the widget it needs.
// @req FEED-0008
fn fp_http_names(id: string) string {
    return "widget.js\nexample.html\nfeeds/" + id + ".json\n"
}

// fp_content_type is the media type a file is sent with.
// @req FEED-0008
fn fp_content_type(name: string) string {
    if fp_ends_with(name, ".json") {
        return "application/json"
    }
    if fp_ends_with(name, ".js") {
        return "text/javascript; charset=utf-8"
    }
    if fp_ends_with(name, ".html") {
        return "text/html; charset=utf-8"
    }
    return "application/octet-stream"
}

// fp_ends_with is whether a name ends with a suffix.
// @req FEED-0008
fn fp_ends_with(value: string, suffix: string) bool {
    let n: u32 = strlen(value)
    let k: u32 = strlen(suffix)
    return n >= k && str_eq(str_slice(value, n - k, k), suffix)
}

// fp_token_ok is whether a bearer token may be kept and sent: 1 to 4096
// characters of RFC 6750's token68 (letters, digits, - . _ ~ + /, then = at the
// end), so it can neither end the header it is in nor start another.
// @req FEED-0008
fn fp_token_ok(token: string) bool {
    let n: u32 = strlen(token)
    if n == 0 || n > FP_TOKEN_MAX {
        return false
    }
    var padding: bool = false
    var i: u32 = 0
    while i < n {
        let c: u8 = str_at(token, i)
        if c == 61 {
            if i == 0 {
                return false
            }
            padding = true
        } else {
            let letter: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            let digit: bool = c >= 48 && c <= 57
            let mark: bool = c == 45 || c == 46 || c == 95 || c == 126 || c == 43 || c == 47
            if padding || (!letter && !digit && !mark) {
                return false
            }
        }
        i = i + 1
    }
    return true
}

// fp_token_file is the name of a publisher's token file, beside the feed file.
// The name has been checked by fd_name_ok, so it cannot name anything else.
// @req FEED-0008
fn fp_token_file(name: string) string {
    return "publisher-" + name + ".token"
}

// fp_bearer is the Authorization header a PUT carries.
// @req FEED-0008
fn fp_bearer(token: string) string {
    return "Authorization: Bearer " + token
}

// fp_curl_quoted is a value as a quoted string of curl's configuration file,
// read back exactly.
// @req FEED-0008
fn fp_curl_quoted(value: string) string {
    return "\"" + str_replace(str_replace(value, "\\", "\\\\"), "\"", "\\\"") + "\""
}

// fp_curl_config is the configuration of one PUT, as curl reads it from a file
// only this user can read: the address and the token never on a command line,
// which any user of the machine can list. No `Expect: 100-continue`, and no
// proxy for the loopback.
// @req FEED-0008
fn fp_curl_config(url: string, token: string, content_type: string) string {
    return "url = " + fp_curl_quoted(url) + "\n" +
        "request = \"PUT\"\n" +
        "header = " + fp_curl_quoted(fp_bearer(token)) + "\n" +
        "header = " + fp_curl_quoted("Content-Type: " + content_type) + "\n" +
        "header = \"Expect:\"\n"
}

// fp_curl_args are curl's arguments for one PUT, one per line: only https and
// http, no redirect followed, the time it may take, the body from a file, the
// status written after a marker, and the rest from the configuration file.
// @req FEED-0008
fn fp_curl_args(body_path: string, config_path: string) string {
    return "-sS\n--proto\n=https,http\n--max-redirs\n0\n--noproxy\n127.0.0.1,localhost,::1\n" +
        "--connect-timeout\n" + int_to_str(FP_HTTP_CONNECT_S) + "\n--max-time\n" + int_to_str(FP_HTTP_TIMEOUT_S) + "\n" +
        "-o\n/dev/null\n-w\nstatus=%{http_code}\n--data-binary\n@" + body_path + "\n-K\n" + config_path + "\n"
}

// fp_curl_status is the HTTP status curl wrote after its marker, 0 when it
// wrote none or no answer came (000).
// @req FEED-0008
fn fp_curl_status(output: string) u32 {
    let at: i32 = str_index_of(output, "status=")
    if at < 0 {
        return 0
    }
    let digits: string = str_slice(output, u32(at) + 7, 3)
    if strlen(digits) != 3 {
        return 0
    }
    var i: u32 = 0
    while i < 3 {
        let c: u8 = str_at(digits, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return int_from_str(digits)
}

// fp_curl_error is curl's own message for a request that got no answer — from
// `curl: (` to the end of its line — or "" when there is none.
// @req FEED-0008
fn fp_curl_error(output: string) string {
    let at: i32 = str_index_of(output, "curl: (")
    if at < 0 {
        return ""
    }
    var message: string = str_slice(output, u32(at), strlen(output) - u32(at))
    let end: i32 = str_index_of(message, "\n")
    if end >= 0 {
        message = str_slice(message, 0, u32(end))
    }
    let marker: i32 = str_index_of(message, "status=")
    if marker >= 0 {
        message = str_slice(message, 0, u32(marker))
    }
    return str_trim(message)
}

// fp_http_failure is why one PUT does not count as done, "" when it does: a
// status other than 2xx, a timeout (curl's exit 28), or no answer with curl's
// message.
// @req FEED-0008
fn fp_http_failure(name: string, exit: u32, status: u32, message: string) string {
    if status >= 200 && status <= 299 && exit == 0 {
        return ""
    }
    if status != 0 {
        return name + ": answered HTTP " + int_to_str(status)
    }
    if exit == 28 {
        return name + ": no answer within " + int_to_str(FP_HTTP_TIMEOUT_S) + " s"
    }
    if message != "" {
        return name + ": no answer (" + message + ")"
    }
    return name + ": no answer (curl exit " + int_to_str(exit) + ")"
}
